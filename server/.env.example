# Copy to .env and fill in. Same file works on the laptop and the Pi --
# only VECTOR_PUBLIC_HOST changes.

# ---------------------------------------------------------------- server ---
VECTOR_HOST=0.0.0.0
VECTOR_PORT=8000

# The address the ESP32 will dial. MUST be the LAN IP of this machine --
# never 127.0.0.1, the device is a different box.
#   laptop: hostname -I | awk '{print $1}'
#   pi:     same
VECTOR_PUBLIC_HOST=192.168.1.50:8000
VECTOR_PUBLIC_SCHEME=ws

# Optional shared secret. If set, it is handed to the device in the OTA
# response and checked on the WebSocket handshake.
VECTOR_AUTH_TOKEN=

VECTOR_LOG_LEVEL=INFO
# Minutes east of UTC. 330 = IST.
VECTOR_TZ_OFFSET_MINUTES=330

# -------------------------------------------------------------------- STT ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# "multi" handles Hindi/English code-switching. Use "en-IN" to pin to English.
DEEPGRAM_LANGUAGE=multi
# Silence in ms before a turn is considered finished. Lower = snappier but
# more likely to cut you off mid-thought.
DEEPGRAM_ENDPOINTING_MS=400
DEEPGRAM_UTTERANCE_END_MS=1000

# -------------------------------------------------------------------- LLM ---
GEMINI_API_KEY=
# IMPORTANT: gemini-2.5-flash began 404ing in July 2026, ahead of its announced
# October shutdown. Run `python tools/list_models.py` to see what your key can
# actually reach, then set this to a live model.
#   gemini-3.5-flash-lite  - cheapest current gen, right choice for short
#                            voice turns ($0.30 / $2.50 per Mtok)
#   gemini-3.6-flash       - smarter, ~5x the price
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=512
VECTOR_HISTORY_TURNS=12

# Keep replies short -- every word costs TTS latency.
VECTOR_SYSTEM_PROMPT=

# -------------------------------------------------------------------- TTS ---
# edge   = free, no signup, no key, good neural voices  <- start here
# gemini = uses your Gemini credits, style-controllable
# piper  = fully local, no network, works offline on the Pi
TTS_PROVIDER=edge

# Indian English voices: en-IN-NeerjaNeural, en-IN-PrabhatNeural
# Hindi: hi-IN-SwaraNeural, hi-IN-MadhurNeural
# List them all: edge-tts --list-voices
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# Only used when TTS_PROVIDER=gemini. Confirm the ID with tools/list_models.py.
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
GEMINI_TTS_VOICE=Kore

# Only used when TTS_PROVIDER=piper.
PIPER_BINARY=piper
PIPER_MODEL=/models/en_US-amy-medium.onnx
PIPER_SAMPLE_RATE=22050

# ------------------------------------------------------------------ audio ---
# Downlink rate we advertise in the hello. The firmware reconfigures its Opus
# decoder to match and resamples to the codec rate, so 24000 is safe.
VECTOR_DOWNLINK_SAMPLE_RATE=24000
VECTOR_FRAME_MS=60
# Frames to send before pacing to realtime. The firmware's decode queue holds
# 40 frames at 60 ms and silently drops the overflow.
VECTOR_PLAYBACK_BURST_FRAMES=15

# Spoken once when a device connects. Leave empty to stay silent.
VECTOR_GREETING=
